# Replace this with the pooled Neon connection string from your project.
# Keep sslmode=require and use the pooled hostname for a deployed/serverless app.
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Canonical HTTPS site origin used for administrator-only password reset links.
APP_URL=https://your-domain.example

# Optional Uganda SMS delivery (numbers are sent to this provider solely for delivery).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Father-DLA AI Language Tutor (server-side only).
# Connects to Google Gemini if GEMINI_API_KEY is provided, or OpenAI if OPENAI_API_KEY is provided.
# Includes built-in DLA educational intelligence fallback when keys are not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resend transactional email delivery (server-side only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set a strong random value and configure the host scheduler to call
# /api/cron/school-emails with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
