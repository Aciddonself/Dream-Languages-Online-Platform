# All values below are FAKE placeholders. Real values go in .env.local (git-ignored). Never commit secrets.

# ---- PUBLIC (shipped to the browser by design) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Turnstile site keys are public by design (the secret below is not).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Google tags; only loaded after the visitor accepts the relevant cookie category.
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-MRFCJ3NB

# ---- SECRET (server only) ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Postgres connection string (use the pooled one on serverless). TLS is verified.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: PEM of the Supabase CA certificate if your platform lacks it.
DATABASE_CA_CERT=
APP_URL=https://your-domain.example
# Pesapal merchant credentials (server only). Use sandbox first; set PESAPAL_IPN_ID
# after registering https://<APP_URL>/api/portal/payments/pesapal/ipn with Pesapal.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Optional secure cPanel Webmail URL shown only in administrator/HOC dashboards.
CPANEL_WEBMAIL_URL=
# Dedicated hostname for administrator sign-in (e.g. admin.your-domain.example). Admin login is refused elsewhere.
ADMIN_HOST=
# Enable only when using the public application origin for /admin/sign-in (e.g. Railway before a separate admin domain exists).
ALLOW_ADMIN_WITHOUT_HOST=false
CRON_SECRET=generate-a-long-random-value
# Create one Cloudflare Turnstile widget for production and place its secret key here.
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis). Falls back to a per-instance memory limiter if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Firebase service account JSON for FCM push (server only, minimum role).
FCM_SERVICE_ACCOUNT_JSON=
# 32-byte base64 key used to encrypt the Google Calendar OAuth refresh token at rest.
MEET_LINK_ENCRYPTION_KEY=
# Google OAuth web application credentials. Redirect URI must point to
# https://<admin-host>/api/admin/google-calendar/callback, or the APP_URL origin when no admin host is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- One-time scripts (set only when running them, then remove) ----------------------------
# seed -> SEED_DEMO_PASSWORD ; create-first-admin -> FIRST_ADMIN_EMAIL, FIRST_ADMIN_PASSWORD
# admin:password-reset -> ADMIN_PASSWORD_RESET_EMAIL, ADMIN_PASSWORD_RESET_PASSWORD
SEED_DEMO_PASSWORD=
ADMIN_PASSWORD_RESET_EMAIL=
ADMIN_PASSWORD_RESET_PASSWORD=
