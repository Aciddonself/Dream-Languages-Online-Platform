# All values below are FAKE placeholders. Real values go in .env.local (git-ignored). Never commit secrets.

# ---- PUBLIC (shipped to the browser by design) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Turnstile site keys are public by design (the secret below is not).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- SECRET (server only) ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Postgres connection string (use the pooled one on serverless). TLS is verified.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: PEM of the Supabase CA certificate if your platform lacks it.
DATABASE_CA_CERT=
APP_URL=https://your-domain.example
CRON_SECRET=generate-a-long-random-value
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis). Falls back to a per-instance memory limiter if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Firebase service account JSON for FCM push (server only, minimum role).
FCM_SERVICE_ACCOUNT_JSON=
# 32-byte base64 key used to encrypt live-class links at rest.
MEET_LINK_ENCRYPTION_KEY=

# ---- One-time scripts (set only when running them, then remove) ----------------------------
# seed -> SEED_DEMO_PASSWORD ; create-first-admin -> FIRST_ADMIN_EMAIL, FIRST_ADMIN_PASSWORD
SEED_DEMO_PASSWORD=
