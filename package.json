    "@upstash/redis": "^1.39.0",
    "apexcharts": "^8.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^14.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
