    "reg:renumber": "tsx scripts/renumber-registrations.ts",
    "test:student-documents": "node --conditions=react-server --import tsx --test tests/student-documents.test.ts",
    "test:holidays": "node --conditions=react-server --import tsx --test tests/holiday-workflow.test.ts",
    "test:father-dla": "tsx --test tests/father-dla.test.ts"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.3",
